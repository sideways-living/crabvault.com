{
  "name": "CrabDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Document Title"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename"
    },
    "normalized_filename": {
      "type": "string",
      "title": "Normalized Filename"
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "enum": [
        "pdf",
        "docx",
        "xlsx",
        "jpg",
        "png",
        "heic",
        "txt",
        "psd",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "source_modified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source Modified At"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash"
    },
    "crab_ids": {
      "type": "array",
      "title": "Linked Crab IDs (legacy)",
      "items": {
        "type": "string"
      }
    },
    "market_ids": {
      "type": "array",
      "title": "Linked Market IDs",
      "items": {
        "type": "string"
      }
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "title": "Document Date"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "correspondence",
        "evidence",
        "receipt",
        "id",
        "legal",
        "medical",
        "financial",
        "other"
      ],
      "default": "other"
    },
    "id_card_side": {
      "type": "string",
      "title": "ID Card Side (front/back)",
      "enum": [
        "front",
        "back"
      ]
    },
    "summary": {
      "type": "string",
      "title": "AI Summary"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Full Text"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "processing_status": {
      "type": "string",
      "title": "Processing Status",
      "enum": [
        "pending",
        "processing",
        "needs_review",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "vault_path": {
      "type": "string",
      "title": "Vault Path"
    },
    "source_path": {
      "type": "string",
      "title": "Source Path (ingress)"
    },
    "ingress_deleted": {
      "type": "boolean",
      "title": "Ingress File Deleted",
      "default": false
    },
    "synced_to_vault": {
      "type": "boolean",
      "title": "Synced to Vault",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_deleted": {
      "type": "boolean",
      "title": "Is Deleted",
      "default": false
    },
    "version": {
      "type": "number",
      "title": "Version Number (legacy)",
      "default": 1
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "version_group_id": {
      "type": "string",
      "title": "Version Group ID"
    },
    "previous_version_id": {
      "type": "string",
      "title": "Previous Version Document ID"
    },
    "is_latest_version": {
      "type": "boolean",
      "title": "Is Latest Version",
      "default": true
    },
    "version_notes": {
      "type": "string",
      "title": "Version Notes"
    },
    "duplicate_status": {
      "type": "string",
      "title": "Duplicate Status",
      "enum": [
        "none",
        "exact_duplicate",
        "renamed_duplicate",
        "possible_version",
        "confirmed_duplicate",
        "confirmed_version",
        "ignored"
      ],
      "default": "none"
    },
    "duplicate_group_id": {
      "type": "string",
      "title": "Duplicate Group ID"
    },
    "duplicate_of_document_id": {
      "type": "string",
      "title": "Duplicate of Document ID"
    },
    "duplicate_review_status": {
      "type": "string",
      "title": "Duplicate Review Status",
      "enum": [
        "not_required",
        "pending_review",
        "resolved"
      ],
      "default": "not_required"
    },
    "duplicate_match_reason": {
      "type": "string",
      "title": "Duplicate Match Reason"
    },
    "duplicate_candidate_ids": {
      "type": "array",
      "title": "Duplicate Candidate IDs",
      "items": {
        "type": "string"
      }
    },
    "duplicate_decision": {
      "type": "object",
      "title": "Duplicate Decision",
      "properties": {
        "action": {
          "type": "string",
          "title": "Action",
          "enum": [
            "keep_existing",
            "keep_new",
            "keep_both",
            "merge_as_version",
            "ignore"
          ]
        },
        "chosen_filename": {
          "type": "string",
          "title": "Chosen Filename"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "title": "Decided At"
        },
        "decided_by": {
          "type": "string",
          "title": "Decided By"
        },
        "notes": {
          "type": "string",
          "title": "Notes"
        }
      }
    },
    "identity_resolution_status": {
      "type": "string",
      "title": "Identity Resolution Status",
      "enum": [
        "matched",
        "ambiguous",
        "unmatched",
        "manually_assigned"
      ]
    },
    "matched_crab_id": {
      "type": "string",
      "title": "Matched Crab ID (primary identity result)"
    },
    "identity_confidence": {
      "type": "string",
      "title": "Identity Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "identity_match_reason": {
      "type": "string",
      "title": "Identity Match Reason"
    },
    "candidate_crab_ids": {
      "type": "array",
      "title": "Candidate Crab IDs (ambiguous matches)",
      "items": {
        "type": "string"
      }
    },
    "extracted_identity": {
      "type": "object",
      "title": "Extracted Identity",
      "properties": {
        "first_name": {
          "type": "string",
          "title": "First Name"
        },
        "middle_name": {
          "type": "string",
          "title": "Middle Name"
        },
        "surname": {
          "type": "string",
          "title": "Surname"
        },
        "date_of_birth": {
          "type": "string",
          "title": "Date of Birth"
        },
        "address": {
          "type": "string",
          "title": "Address"
        },
        "phone": {
          "type": "string",
          "title": "Phone"
        },
        "email": {
          "type": "string",
          "title": "Email"
        },
        "id_numbers": {
          "type": "array",
          "title": "ID Numbers",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}