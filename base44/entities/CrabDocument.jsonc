{
  "name": "CrabDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Document Title"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "original_file_url": {
      "type": "string",
      "title": "Original File URL (immutable)"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename (immutable)"
    },
    "original_content_hash": {
      "type": "string",
      "title": "Original Content Hash (immutable)"
    },
    "original_file_size": {
      "type": "number",
      "title": "Original File Size in bytes (immutable)"
    },
    "original_uploaded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Original Uploaded At (immutable)"
    },
    "normalized_filename": {
      "type": "string",
      "title": "Normalized Filename"
    },
    "suggested_filename": {
      "type": "string",
      "title": "Suggested Filename (from bulk reprocess)"
    },
    "naming_status": {
      "type": "string",
      "title": "Naming Status",
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "applied"
      ],
      "default": "pending"
    },
    "extracted_naming_data": {
      "type": "object",
      "title": "Extracted Naming Data (from filename reprocessing)",
      "properties": {
        "document_kind": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "document_description": {
          "type": "string"
        },
        "card_number": {
          "type": "string"
        },
        "card_last_four": {
          "type": "string"
        },
        "card_expiry": {
          "type": "string"
        },
        "card_cvv": {
          "type": "string"
        },
        "card_issuer": {
          "type": "string"
        },
        "card_account_type": {
          "type": "string"
        },
        "card_type": {
          "type": "string"
        },
        "filename_confidence": {
          "type": "string"
        },
        "review_reason": {
          "type": "string"
        },
        "processed_at": {
          "type": "string"
        }
      }
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "enum": [
        "pdf",
        "docx",
        "xlsx",
        "jpg",
        "png",
        "heic",
        "txt",
        "psd",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "source_modified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source Modified At"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash"
    },
    "crab_ids": {
      "type": "array",
      "title": "Linked Crab IDs (legacy)",
      "items": {
        "type": "string"
      }
    },
    "market_ids": {
      "type": "array",
      "title": "Linked Market IDs",
      "items": {
        "type": "string"
      }
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "title": "Document Date"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "correspondence",
        "evidence",
        "receipt",
        "id",
        "legal",
        "medical",
        "financial",
        "other"
      ],
      "default": "other"
    },
    "id_card_side": {
      "type": "string",
      "title": "ID Card Side (front/back)",
      "enum": [
        "front",
        "back"
      ]
    },
    "summary": {
      "type": "string",
      "title": "AI Summary"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Full Text"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "processing_status": {
      "type": "string",
      "title": "Processing Status",
      "enum": [
        "pending",
        "processing",
        "needs_review",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "processing_error": {
      "type": "string",
      "title": "Processing Error"
    },
    "last_processing_job_id": {
      "type": "string",
      "title": "Last Processing Job ID"
    },
    "ai_processed_file_url": {
      "type": "string",
      "title": "File URL used during AI processing"
    },
    "ai_processed_content_hash": {
      "type": "string",
      "title": "Content Hash verified during AI processing"
    },
    "ai_processed_at": {
      "type": "string",
      "format": "date-time",
      "title": "AI Processed At"
    },
    "ai_confidence": {
      "type": "string",
      "title": "AI Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "requires_human_review": {
      "type": "boolean",
      "title": "Requires Human Review",
      "default": false
    },
    "review_reason": {
      "type": "string",
      "title": "Review Reason"
    },
    "ai_extraction_result": {
      "type": "object",
      "title": "AI Extraction Result (proposed/suggested only)",
      "properties": {
        "suggested_title": {
          "type": "string"
        },
        "suggested_summary": {
          "type": "string"
        },
        "suggested_category": {
          "type": "string"
        },
        "suggested_document_date": {
          "type": "string"
        },
        "suggested_id_card_side": {
          "type": "string"
        },
        "suggested_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string"
        },
        "processed_at": {
          "type": "string"
        },
        "file_url_used": {
          "type": "string"
        },
        "content_hash_used": {
          "type": "string"
        }
      }
    },
    "vault_path": {
      "type": "string",
      "title": "Vault Path"
    },
    "source_path": {
      "type": "string",
      "title": "Source Path (ingress)"
    },
    "ingress_deleted": {
      "type": "boolean",
      "title": "Ingress File Deleted",
      "default": false
    },
    "synced_to_vault": {
      "type": "boolean",
      "title": "Synced to Vault",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_deleted": {
      "type": "boolean",
      "title": "Is Deleted",
      "default": false
    },
    "version": {
      "type": "number",
      "title": "Version Number (legacy)",
      "default": 1
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "version_group_id": {
      "type": "string",
      "title": "Version Group ID"
    },
    "previous_version_id": {
      "type": "string",
      "title": "Previous Version Document ID"
    },
    "is_latest_version": {
      "type": "boolean",
      "title": "Is Latest Version",
      "default": true
    },
    "version_notes": {
      "type": "string",
      "title": "Version Notes"
    },
    "duplicate_status": {
      "type": "string",
      "title": "Duplicate Status",
      "enum": [
        "none",
        "exact_duplicate",
        "renamed_duplicate",
        "possible_version",
        "confirmed_duplicate",
        "confirmed_version",
        "ignored"
      ],
      "default": "none"
    },
    "duplicate_group_id": {
      "type": "string",
      "title": "Duplicate Group ID"
    },
    "duplicate_of_document_id": {
      "type": "string",
      "title": "Duplicate of Document ID"
    },
    "duplicate_review_status": {
      "type": "string",
      "title": "Duplicate Review Status",
      "enum": [
        "not_required",
        "pending_review",
        "resolved"
      ],
      "default": "not_required"
    },
    "duplicate_match_reason": {
      "type": "string",
      "title": "Duplicate Match Reason"
    },
    "duplicate_candidate_ids": {
      "type": "array",
      "title": "Duplicate Candidate IDs",
      "items": {
        "type": "string"
      }
    },
    "duplicate_decision": {
      "type": "object",
      "title": "Duplicate Decision",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "keep_existing",
            "keep_new",
            "keep_both",
            "merge_as_version",
            "ignore"
          ]
        },
        "chosen_filename": {
          "type": "string"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decided_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "identity_resolution_status": {
      "type": "string",
      "title": "Identity Resolution Status",
      "enum": [
        "matched",
        "ambiguous",
        "unmatched",
        "manually_assigned"
      ]
    },
    "matched_crab_id": {
      "type": "string",
      "title": "Matched Crab ID"
    },
    "identity_confidence": {
      "type": "string",
      "title": "Identity Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "identity_match_reason": {
      "type": "string",
      "title": "Identity Match Reason"
    },
    "candidate_crab_ids": {
      "type": "array",
      "title": "Candidate Crab IDs",
      "items": {
        "type": "string"
      }
    },
    "extracted_identity": {
      "type": "object",
      "title": "Extracted Identity",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "middle_name": {
          "type": "string"
        },
        "surname": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "id_numbers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}