{
  "name": "WorkflowStepTemplate",
  "type": "object",
  "properties": {
    "workflow_template_id": {
      "type": "string",
      "title": "Workflow Template ID"
    },
    "step_number": {
      "type": "number",
      "title": "Step Number",
      "default": 1
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "assigned_role": {
      "type": "string",
      "title": "Assigned Role"
    },
    "assigned_user_id": {
      "type": "string",
      "title": "Assigned User ID"
    },
    "due_days_from_commencement": {
      "type": "number",
      "title": "Due Days from Commencement",
      "default": 7
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "is_start_step": {
      "type": "boolean",
      "title": "Is Start Step",
      "default": false
    },
    "is_final_step": {
      "type": "boolean",
      "title": "Is Final Step",
      "default": false
    },
    "completion_fields": {
      "type": "array",
      "title": "Completion Fields",
      "description": "Fields to collect when completing this task",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "Field Key (unique identifier)"
          },
          "label": {
            "type": "string",
            "title": "Label shown to user"
          },
          "type": {
            "type": "string",
            "title": "Field Type",
            "enum": [
              "text",
              "document_upload",
              "document_upload_pair"
            ]
          },
          "default_value": {
            "type": "string",
            "title": "Default Value"
          },
          "profile_update_path": {
            "type": "string",
            "title": "Profile field to update (e.g. phone, email, yellowbank_last_branch)"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "workflow_template_id",
    "title"
  ]
}