{
  "name": "YellowBankAccount",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "title": "CrabModule ID"
    },
    "crab_id": {
      "type": "string",
      "title": "Crab ID"
    },
    "bank": {
      "type": "string",
      "title": "Bank",
      "default": "Yellow Bank"
    },
    "account_type": {
      "type": "string",
      "title": "Account Type"
    },
    "bsb": {
      "type": "string",
      "title": "BSB"
    },
    "bsb_institution_name": {
      "type": "string",
      "title": "BSB Institution Name"
    },
    "bsb_branch_name": {
      "type": "string",
      "title": "BSB Branch Name"
    },
    "bsb_address": {
      "type": "string",
      "title": "BSB Address"
    },
    "account_number": {
      "type": "string",
      "title": "Account Number"
    },
    "linked_card_ids": {
      "type": "array",
      "title": "Linked Card IDs",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "module_id",
    "crab_id"
  ]
}