{
  "name": "RedBankCard",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "title": "CrabModule ID"
    },
    "crab_id": {
      "type": "string",
      "title": "Crab ID"
    },
    "card_number": {
      "type": "string",
      "title": "Card Number (XXXX XXXX XXXX XXXX)"
    },
    "expiry": {
      "type": "string",
      "title": "Expiry (MM/YY)"
    },
    "ccv": {
      "type": "string",
      "title": "CCV"
    },
    "is_digital": {
      "type": "boolean",
      "title": "Digital Card",
      "default": false
    },
    "is_physical": {
      "type": "boolean",
      "title": "Physical Card",
      "default": false
    },
    "pin_set": {
      "type": "boolean",
      "title": "PIN Set",
      "default": false
    },
    "digital_wallet": {
      "type": "boolean",
      "title": "Added to Digital Wallet",
      "default": false
    },
    "linked_account_id": {
      "type": "string",
      "title": "Linked Account ID"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "module_id",
    "crab_id"
  ]
}