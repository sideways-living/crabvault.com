{
  "name": "ProcessingLog",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "processing_job_id": {
      "type": "string",
      "title": "Processing Job ID"
    },
    "action": {
      "type": "string",
      "title": "Action",
      "enum": [
        "ai_processing",
        "rename",
        "vault_sync",
        "duplicate_check",
        "profile_assignment",
        "ingest",
        "repair",
        "hash_backfill"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "started",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "started"
    },
    "file_url": {
      "type": "string",
      "title": "File URL at time of action"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash at time of action"
    },
    "file_size": {
      "type": "number",
      "title": "File Size at time of action"
    },
    "details": {
      "type": "string",
      "title": "Details / Error"
    },
    "task": {
      "type": "string",
      "title": "Task Description (legacy)"
    }
  },
  "required": [
    "document_id",
    "action"
  ]
}