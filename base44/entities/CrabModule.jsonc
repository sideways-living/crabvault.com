{
  "name": "CrabModule",
  "type": "object",
  "properties": {
    "crab_id": {
      "type": "string",
      "title": "Crab ID"
    },
    "module_type": {
      "type": "string",
      "title": "Module Type",
      "enum": [
        "redbank",
        "yellowbank"
      ],
      "default": "redbank"
    },
    "override_phone": {
      "type": "string",
      "title": "Override Phone"
    },
    "override_email": {
      "type": "string",
      "title": "Override Email"
    },
    "override_address1": {
      "type": "string",
      "title": "Override Address Line 1"
    },
    "override_address2": {
      "type": "string",
      "title": "Override Address Line 2"
    },
    "override_suburb": {
      "type": "string",
      "title": "Override Suburb"
    },
    "override_state": {
      "type": "string",
      "title": "Override State"
    },
    "override_postcode": {
      "type": "string",
      "title": "Override Postcode"
    },
    "redbank_customer_number": {
      "type": "string",
      "title": "RedBank Customer Number"
    },
    "redbank_password": {
      "type": "string",
      "title": "RedBank Password"
    },
    "redbank_app_pin": {
      "type": "string",
      "title": "RedBank App PIN (4 digits)"
    },
    "telephone_access_code": {
      "type": "string",
      "title": "Telephone Access Code (3 digits)"
    },
    "has_joint_accounts": {
      "type": "boolean",
      "title": "Has Joint Accounts",
      "default": false
    },
    "redbank_joint_holder_name": {
      "type": "string",
      "title": "Joint Account Holder Name"
    },
    "redbank_joint_accounts": {
      "type": "number",
      "title": "Number of Joint Accounts"
    },
    "yellowbank_client_number": {
      "type": "string",
      "title": "YellowBank Client Number"
    },
    "yellowbank_password": {
      "type": "string",
      "title": "YellowBank Password"
    },
    "yellowbank_app_pin": {
      "type": "string",
      "title": "YellowBank App PIN"
    },
    "yellowbank_telephone_pin": {
      "type": "string",
      "title": "YellowBank Telephone PIN"
    },
    "yellowbank_security_q1": {
      "type": "string",
      "title": "Security Question 1"
    },
    "yellowbank_security_a1": {
      "type": "string",
      "title": "Security Answer 1"
    },
    "yellowbank_security_q2": {
      "type": "string",
      "title": "Security Question 2"
    },
    "yellowbank_security_a2": {
      "type": "string",
      "title": "Security Answer 2"
    },
    "yellowbank_last_branch": {
      "type": "string",
      "title": "Last Branch Visited"
    },
    "yellowbank_last_branch_purpose": {
      "type": "string",
      "title": "Last Branch Purpose"
    },
    "yellowbank_payids": {
      "type": "array",
      "title": "YellowBank PayIDs",
      "items": {
        "type": "object",
        "properties": {
          "payid": {
            "type": "string",
            "title": "PayID"
          },
          "linked_account_id": {
            "type": "string",
            "title": "Linked Account ID"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "crab_id",
    "module_type"
  ]
}