{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "store_brand": {
      "type": "string",
      "title": "Store Brand"
    },
    "store_location": {
      "type": "string",
      "title": "Store Location"
    },
    "transaction_date": {
      "type": "string",
      "title": "Transaction Date (YYYYMMDD)"
    },
    "transaction_time": {
      "type": "string",
      "title": "Transaction Time (HH:MM)"
    },
    "transaction_type": {
      "type": "string",
      "title": "Transaction Type",
      "enum": [
        "purchase",
        "return",
        "exchange"
      ]
    },
    "tender_type": {
      "type": "string",
      "title": "Tender Type",
      "enum": [
        "cash",
        "mastercard",
        "visa",
        "amex",
        "eftpos",
        "gift_voucher",
        "exchange_voucher",
        "other"
      ]
    },
    "amount": {
      "type": "number",
      "title": "Total Amount"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal (before tax)"
    },
    "tax_amount": {
      "type": "number",
      "title": "Tax Amount (GST/VAT)"
    },
    "last_four_digits": {
      "type": "string",
      "title": "Last 4 Digits"
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt / Transaction Number"
    },
    "items": {
      "type": "array",
      "title": "Items",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Item Name"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "total_price": {
            "type": "number",
            "title": "Total Price"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "document_id"
  ]
}