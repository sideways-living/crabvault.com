{
  "name": "Crab",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "middle_name": {
      "type": "string",
      "title": "Middle Name"
    },
    "surname": {
      "type": "string",
      "title": "Surname"
    },
    "full_name": {
      "type": "string",
      "title": "Full Name (computed / display)"
    },
    "aliases": {
      "type": "array",
      "title": "Known Aliases",
      "items": {
        "type": "string"
      }
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL"
    },
    "phone": {
      "type": "string",
      "title": "Main Phone Number"
    },
    "additional_phones": {
      "type": "array",
      "title": "Additional Phone Numbers",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "title": "Phone Number"
          },
          "label": {
            "type": "string",
            "title": "Label (e.g., Work, Mobile)"
          }
        }
      }
    },
    "email": {
      "type": "string",
      "title": "Main Email Address"
    },
    "additional_emails": {
      "type": "array",
      "title": "Additional Emails",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "label": {
            "type": "string",
            "title": "Label (e.g., Work, Personal)"
          }
        }
      }
    },
    "address1": {
      "type": "string",
      "title": "Main Residential Address Line 1"
    },
    "address2": {
      "type": "string",
      "title": "Main Residential Address Line 2"
    },
    "suburb": {
      "type": "string",
      "title": "Main Residential Suburb"
    },
    "state": {
      "type": "string",
      "title": "Main Residential State"
    },
    "postcode": {
      "type": "string",
      "title": "Main Residential Postcode"
    },
    "country": {
      "type": "string",
      "title": "Main Residential Country",
      "default": "Australia"
    },
    "additional_addresses": {
      "type": "array",
      "title": "Additional Addresses",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label (e.g., Work, Holiday Home)"
          },
          "address1": {
            "type": "string",
            "title": "Address Line 1"
          },
          "address2": {
            "type": "string",
            "title": "Address Line 2"
          },
          "suburb": {
            "type": "string",
            "title": "Suburb"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "postcode": {
            "type": "string",
            "title": "Postcode"
          },
          "country": {
            "type": "string",
            "title": "Country"
          }
        }
      }
    },
    "mailing_same_as_residential": {
      "type": "boolean",
      "title": "Mailing Address Same as Residential",
      "default": true
    },
    "mailing_address1": {
      "type": "string",
      "title": "Mailing Address Line 1"
    },
    "mailing_address2": {
      "type": "string",
      "title": "Mailing Address Line 2"
    },
    "mailing_suburb": {
      "type": "string",
      "title": "Mailing Suburb"
    },
    "mailing_state": {
      "type": "string",
      "title": "Mailing State"
    },
    "mailing_postcode": {
      "type": "string",
      "title": "Mailing Postcode"
    },
    "mailing_country": {
      "type": "string",
      "title": "Mailing Country",
      "default": "Australia"
    },
    "id_numbers": {
      "type": "array",
      "title": "ID Numbers / References",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        }
      }
    },
    "emergency_summary": {
      "type": "string",
      "title": "Emergency Summary (quick facts)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "inactive",
        "banned",
        "watch",
        "nathan",
        "tony",
        "nigel",
        "ben"
      ],
      "default": "nathan"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "is_deleted": {
      "type": "boolean",
      "title": "Is Deleted",
      "default": false
    }
  },
  "required": [
    "surname"
  ]
}