{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Document Title"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "preview_url": {
      "type": "string",
      "title": "Preview Image URL"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename"
    },
    "normalized_filename": {
      "type": "string",
      "title": "Normalized Filename"
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "enum": [
        "pdf",
        "docx",
        "xlsx",
        "pptx",
        "txt",
        "jpg",
        "png",
        "heic",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "source_modified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Source Modified At"
    },
    "content_hash": {
      "type": "string",
      "title": "Content Hash"
    },
    "folder_id": {
      "type": "string",
      "title": "Folder ID"
    },
    "category_id": {
      "type": "string",
      "title": "Category ID"
    },
    "summary": {
      "type": "string",
      "title": "AI Summary"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Text Content"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "processing_status": {
      "type": "string",
      "title": "Processing Status",
      "enum": [
        "pending",
        "processing",
        "needs_review",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "is_searchable_pdf": {
      "type": "boolean",
      "title": "Is Searchable PDF",
      "default": false
    },
    "vault_path": {
      "type": "string",
      "title": "Cryptomator Vault Path"
    },
    "source_path": {
      "type": "string",
      "title": "Source Path (shared folder)"
    },
    "scan_date": {
      "type": "string",
      "format": "date",
      "title": "Scan / Created Date"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "title": "Document Date (from document)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "ai_data": {
      "type": "object",
      "title": "Raw AI Extraction Data"
    },
    "is_deleted": {
      "type": "boolean",
      "title": "Is Deleted",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Deletion Date"
    },
    "synced_to_vault": {
      "type": "boolean",
      "title": "Synced to Cryptomator Vault",
      "default": false
    },
    "duplicate_status": {
      "type": "string",
      "title": "Duplicate Status",
      "enum": [
        "none",
        "exact_duplicate",
        "renamed_duplicate",
        "possible_version",
        "confirmed_duplicate",
        "confirmed_version",
        "ignored"
      ],
      "default": "none"
    },
    "duplicate_group_id": {
      "type": "string",
      "title": "Duplicate Group ID"
    },
    "version_group_id": {
      "type": "string",
      "title": "Version Group ID"
    },
    "version_number": {
      "type": "number",
      "title": "Version Number",
      "default": 1
    },
    "previous_version_id": {
      "type": "string",
      "title": "Previous Version Document ID"
    },
    "is_latest_version": {
      "type": "boolean",
      "title": "Is Latest Version",
      "default": true
    },
    "duplicate_of_document_id": {
      "type": "string",
      "title": "Duplicate of Document ID"
    },
    "duplicate_review_status": {
      "type": "string",
      "title": "Duplicate Review Status",
      "enum": [
        "not_required",
        "pending_review",
        "resolved"
      ],
      "default": "not_required"
    },
    "duplicate_match_reason": {
      "type": "string",
      "title": "Duplicate Match Reason"
    },
    "duplicate_candidate_ids": {
      "type": "array",
      "title": "Duplicate Candidate IDs",
      "items": {
        "type": "string"
      }
    },
    "duplicate_decision": {
      "type": "object",
      "title": "Duplicate Decision",
      "properties": {
        "action": {
          "type": "string",
          "title": "Action",
          "enum": [
            "keep_existing",
            "keep_new",
            "keep_both",
            "merge_as_version",
            "ignore"
          ]
        },
        "chosen_filename": {
          "type": "string",
          "title": "Chosen Filename"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "title": "Decided At"
        },
        "decided_by": {
          "type": "string",
          "title": "Decided By"
        },
        "notes": {
          "type": "string",
          "title": "Notes"
        }
      }
    }
  },
  "required": [
    "title"
  ]
}