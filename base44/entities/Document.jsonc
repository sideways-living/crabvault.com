{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Document Title"
    },
    "file_url": {
      "type": "string",
      "title": "File URL"
    },
    "preview_url": {
      "type": "string",
      "title": "Preview Image URL"
    },
    "original_filename": {
      "type": "string",
      "title": "Original Filename"
    },
    "file_type": {
      "type": "string",
      "title": "File Type",
      "enum": [
        "pdf",
        "docx",
        "xlsx",
        "pptx",
        "txt",
        "jpg",
        "png",
        "heic",
        "other"
      ]
    },
    "file_size": {
      "type": "number",
      "title": "File Size (bytes)"
    },
    "folder_id": {
      "type": "string",
      "title": "Folder ID"
    },
    "category_id": {
      "type": "string",
      "title": "Category ID"
    },
    "summary": {
      "type": "string",
      "title": "AI Summary"
    },
    "extracted_text": {
      "type": "string",
      "title": "Extracted Text Content"
    },
    "tags": {
      "type": "array",
      "title": "Tags",
      "items": {
        "type": "string"
      }
    },
    "processing_status": {
      "type": "string",
      "title": "Processing Status",
      "enum": [
        "pending",
        "processing",
        "needs_review",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "is_searchable_pdf": {
      "type": "boolean",
      "title": "Is Searchable PDF",
      "default": false
    },
    "vault_path": {
      "type": "string",
      "title": "Cryptomator Vault Path"
    },
    "source_path": {
      "type": "string",
      "title": "Source Path (shared folder)"
    },
    "scan_date": {
      "type": "string",
      "format": "date",
      "title": "Scan / Created Date"
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "title": "Document Date (from document)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "ai_data": {
      "type": "object",
      "title": "Raw AI Extraction Data"
    },
    "is_deleted": {
      "type": "boolean",
      "title": "Is Deleted",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Deletion Date"
    },
    "synced_to_vault": {
      "type": "boolean",
      "title": "Synced to Cryptomator Vault",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}